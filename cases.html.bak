<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PMI中国 · 案例库 | AI项目管理社区</title>
<style>
  :root{--pmi-blue:#003DA5;--pmi-teal:#40C1AC;--pmi-orange:#FF6F00;--ink:#1d2733;--line:#e6ebf2}
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif;background:#eef2f7;color:var(--ink)}
  .header{background:linear-gradient(135deg,var(--pmi-blue),#009CDE);color:#fff;padding:16px 20px;position:sticky;top:0;z-index:10}
  .header h1{margin:0;font-size:18px}
  .header .back{display:inline-block;margin-top:8px;color:rgba(255,255,255,.8);text-decoration:none;font-size:14px}
  .stats-bar{background:#fff;padding:16px 20px;display:flex;gap:24px;border-bottom:1px solid var(--line)}
  .stat-item{text-align:center}
  .stat-item b{display:block;font-size:24px;color:var(--pmi-blue)}
  .stat-item span{font-size:12px;color:#888}
  .content{max-width:1000px;margin:0 auto;padding:20px}
  .search-box{background:#fff;border-radius:12px;padding:16px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
  .search-box input{width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:8px;font-size:15px}
  .industry-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:24px}
  .industry-card{background:#fff;border-radius:12px;padding:16px;cursor:pointer;transition:all .2s;border:2px solid transparent;box-shadow:0 2px 8px rgba(0,0,0,.04)}
  .industry-card:hover{border-color:var(--pmi-blue);transform:translateY(-2px)}
  .industry-card.active{border-color:var(--pmi-blue);background:#f0f7ff}
  .industry-card h3{margin:0 0 6px;font-size:16px;color:var(--pmi-blue)}
  .industry-card p{margin:0;font-size:13px;color:#888}
  .case-list{background:#fff;border-radius:12px;padding:16px;min-height:200px}
  .case-item{padding:12px 0;border-bottom:1px solid var(--line);cursor:pointer}
  .case-item:last-child{border-bottom:none}
  .case-item:hover{background:#f8fafc}
  .case-item h4{margin:0 0 4px;font-size:15px}
  .case-item p{margin:0;font-size:13px;color:#666}
  .loading{text-align:center;padding:40px;color:#999}
</style>
</head>
<body>
<div class="header">
  <h1>📊 案例库</h1>
  <a href="/" class="back">← 返回首页</a>
</div>
<div class="stats-bar" id="statsBar">
  <div class="stat-item"><b id="totalCases">-</b><span>总案例数</span></div>
  <div class="stat-item"><b id="totalIndustries">-</b><span>行业分类</span></div>
</div>
<div class="content">
  <div class="search-box">
    <input type="text" id="searchInput" placeholder="搜索案例名称...">
  </div>
  <h3 style="margin:0 0 16px">按行业筛选</h3>
  <div class="industry-grid" id="industryGrid"></div>
  <h3 style="margin:0 0 16px" id="currentIndustry">全部案例</h3>
  <div class="case-list" id="caseList">
    <div class="loading">加载中...</div>
  </div>
</div>
<script>
let allCases = [];
let industries = [];
let currentFilter = null;

// 加载数据
fetch("/api/cases")
  .then(r => r.json())
  .then(data => {
    document.getElementById("totalCases").textContent = data.total;
    document.getElementById("totalIndustries").textContent = data.industries.length;
    industries = data.industries;
    renderIndustryGrid();
    loadAllCases();
  });

function renderIndustryGrid() {
  const grid = document.getElementById("industryGrid");
  // 全部选项
  let html = `<div class="industry-card active" onclick="filterIndustry(null)">
    <h3>全部行业</h3>
    <p>${industries.length} 个分类</p>
  </div>`;
  industries.forEach(ind => {
    const name = ind.replace(/^M\d+_/,"");
    html += `<div class="industry-card" onclick="filterIndustry()">
      <h3>${name}</h3>
      <p>查看案例 →</p>
    </div>`;
  });
  grid.innerHTML = html;
}

async function loadAllCases() {
  const resp = await fetch("/api/cases");
  const data = await resp.json();
  allCases = [];
  Object.entries(data.industries).forEach(([ind, cases]) => {
    cases.forEach(c => allCases.push({name: c, industry: ind}));
  });
  renderCases(allCases, "全部案例");
}

function filterIndustry(industry) {
  currentFilter = industry;
  document.querySelectorAll(".industry-card").forEach(el => el.classList.remove("active"));
  event.currentTarget.classList.add("active");
  
  const nameEl = document.getElementById("currentIndustry");
  if (!industry) {
    nameEl.textContent = "全部案例";
    renderCases(allCases);
  } else {
    const name = industry.replace(/^M\d+_/,"");
    nameEl.textContent = name + "（" + allCases.filter(c => c.industry === industry).length + "个）";
    const filtered = allCases.filter(c => c.industry === industry);
    renderCases(filtered);
  }
}

function renderCases(cases, title) {
  const list = document.getElementById("caseList");
  if (!cases || cases.length === 0) {
    list.innerHTML = "<div class=\"loading\">暂无案例</div>";
    return;
  }
  list.innerHTML = cases.slice(0, 100).map(c => `
    <div class="case-item">
      <h4>${c.name}</h4>
      <p>${c.industry.replace(/^M\d+_/,"")}</p>
    </div>
  `).join("");
  if (cases.length > 100) {
    list.innerHTML += `<div class="loading">还有 ${cases.length - 100} 个案例，请筛选查看</div>`;
  }
}

// 搜索功能
document.getElementById("searchInput").addEventListener("input", e => {
  const q = e.target.value.toLowerCase();
  if (!q) {
    renderCases(allCases);
    return;
  }
  const filtered = allCases.filter(c => c.name.toLowerCase().includes(q));
  renderCases(filtered, `搜索「${e.target.value}」`);
});
</script>
</body>
</html>
